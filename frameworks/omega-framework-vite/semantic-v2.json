  "rules": [
    {
      "id": "vite.config.direct-plugin-call",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "data.ecmascript_call_object_array_direct_call_context"
        },
        {
          "kind": "field_equals",
          "field": "call_name",
          "value": "defineConfig"
        },
        {
          "kind": "field_equals",
          "field": "key",
          "value": "plugins"
        },
        {
          "kind": "field_present",
          "field": "item_call_name"
        },
        {
          "kind": "path_glob",
          "pattern": "**/vite.config.{js,ts,mjs,mts}"
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "BuildProject",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "vite:build-project:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "declaration_only": true,
            "source": "vite_config_defineConfig"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Dependency",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "vite:plugin-declaration:{path}:{item_call_name}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "item_call_name"
            },
            "declaration_only": true,
            "resolved_package": false
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "uses_plugin",
          "source": {
            "kind": "by_canonical_key",
            "template": "vite:build-project:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "vite:plugin-declaration:{path}:{item_call_name}"
          },
          "attributes": {
            "declaration_only": true,
            "execution_not_claimed": true,
            "resolved_package_not_claimed": true
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "candidate",
      "coverage_note": "Only direct plugin call items authored in defineConfig({plugins:[...]}) inside vite.config.*; import provenance, variables, member calls, plugin execution and resolved package identity remain outside this rule."
    },
