{
  "schema_version": 2,
  "asset": "omega-framework-bun",
  "selector": "framework:bun",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "javascript",
      "typescript",
      "tsx",
      "toml"
    ],
    "required_packs": [
      "omega-javascript",
      "omega-typescript",
      "omega-tsx",
      "omega-toml"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "imports"
    ]
  },
  "evidence_inputs": [
    "existing_language_ir",
    "imports_bindings",
    "calls_members",
    "project_level_evidence"
  ],
  "emits": {
    "entities": [
      "BunConfigFile",
      "BunConfigSetting",
      "BunConfigTable",
      "BunDatabase",
      "BunFile",
      "BunFileAccess",
      "BunModule",
      "BunNativeBinding",
      "BunNativeLibrary",
      "BunProcess",
      "BunQuery",
      "BunResource",
      "BunServer",
      "BunTest",
      "BunTestHook"
    ],
    "relations": [
      "configured_by",
      "creates_server",
      "depends_on",
      "registers_test",
      "spawns",
      "uses_api",
      "uses_resource"
    ]
  },
  "rules": [
    {
      "id": "bun.builtin-module.import",
      "match": [
        {
          "kind": "fact_kind",
          "value": "import.module"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "bun",
            "bun:ffi",
            "bun:jsc",
            "bun:main",
            "bun:sqlite",
            "bun:test",
            "bun:wrap"
          ]
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.*s*"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "BunFile",
          "canonical_key": {
            "template": "bun:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "BunModule",
          "canonical_key": {
            "template": "bun:module:{definition.name}"
          },
          "attributes": {
            "module": {
              "kind": "field_ref",
              "field": "definition.name"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "depends_on",
          "source": {
            "kind": "current"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "bun:module:{definition.name}"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "observed",
      "confidence": "exact",
      "coverage_note": "A static import, dynamic import or require whose specifier is a Bun built-in module. This is the one piece of Bun evidence a Pack states without ambiguity, and it is what makes the bun:test, bun:sqlite and bun:ffi files of a project findable."
    },
    {
      "id": "bun.server.serve",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_equals",
          "field": "definition.name",
          "value": "serve"
        },
        {
          "kind": "field_equals",
          "field": "receiver",
          "value": "Bun"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.*s*"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "BunServer",
          "canonical_key": {
            "template": "bun:server:{path}:{source.start}"
          },
          "attributes": {
            "api": "Bun.serve",
            "receiver": {
              "kind": "field_ref",
              "field": "receiver"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "BunFile",
          "canonical_key": {
            "template": "bun:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "creates_server",
          "source": {
            "kind": "by_canonical_key",
            "template": "bun:file:{path}"
          },
          "target": {
            "kind": "current"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "Where an HTTP server is declared: Bun.serve(...), proven by the receiver field the JS/TS Packs now publish on call.method, so app.serve(...) no longer matches. The port and the routes table are inside the one object-literal argument, which arrives whole as call.arg0_text and whose properties no Pack states."
    },
    {
      "id": "bun.server.serve-import",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.function"
        },
        {
          "kind": "field_equals",
          "field": "definition.name",
          "value": "serve"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.*s*"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.module",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "bind": "module",
          "where": [
            {
              "kind": "field_in",
              "field": "definition.name",
              "values": [
                "bun"
              ]
            }
          ]
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "BunServer",
          "canonical_key": {
            "template": "bun:server:{path}:{source.start}"
          },
          "attributes": {
            "api": "serve",
            "module": {
              "kind": "field_ref",
              "field": "module.definition.name"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "BunFile",
          "canonical_key": {
            "template": "bun:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "runtime": "bun"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "creates_server",
          "source": {
            "kind": "by_canonical_key",
            "template": "bun:file:{path}"
          },
          "target": {
            "kind": "current"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "The other spelling of the same declaration: a named import of serve from bun, called bare. The bare call carries no receiver, so the import in the same file is the evidence. Same key space and the same entity kind as bun.server.serve, so the two spellings are one answer."
    },
