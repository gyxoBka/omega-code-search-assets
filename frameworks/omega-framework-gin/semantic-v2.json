{
  "schema_version": 2,
  "asset": "omega-framework-gin",
  "selector": "framework:gin",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "go"
    ],
    "required_packs": [
      "omega-go"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "imports",
      "references",
      "scopes",
      "types"
    ]
  },
  "evidence_inputs": [
    "imports_bindings",
    "calls_members",
    "existing_language_ir",
    "project_level_evidence"
  ],
  "emits": {
    "entities": [
      "Controller",
      "Dependency",
      "Handler",
      "Middleware",
      "Package",
      "RequestBinding",
      "RequestModel",
      "Route",
      "Router",
      "RouterConstructor",
      "RouterGroup",
      "StaticResource",
      "ValidatedField"
    ],
    "relations": [
      "binds_request",
      "configured_by",
      "declares",
      "depends_on",
      "handles",
      "mounts",
      "uses_resource",
      "validates"
    ]
  },
  "rules": [
    {
      "id": "gin.dependency.import",
      "match": [
        {
          "kind": "fact_kind",
          "value": "import.package"
        },
        {
          "kind": "field_prefix",
          "field": "definition.name",
          "value": "github.com/gin-"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Dependency",
          "canonical_key": {
            "template": "gin:dependency:{definition.name}"
          },
          "attributes": {
            "module_path": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Package",
          "canonical_key": {
            "template": "gin:package:{path.dir}"
          },
          "attributes": {
            "package_dir": {
              "kind": "field_ref",
              "field": "path.dir"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "depends_on",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:package:{path.dir}"
          },
          "target": {
            "kind": "current"
          }
        }
      ],
      "coverage_note": "A Go package that imports github.com/gin-gonic/gin or a gin-contrib module depends on it; the Package end is the directory, which is what a Go package is."
    },
    {
      "id": "gin.handler.function",
      "match": [
        {
          "kind": "fact_kind",
          "value": "definition.parameter_shape_candidate"
        },
        {
          "kind": "path_glob",
          "field": "definition.name",
          "pattern": "**gin.Context*"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.function",
          "relation": "same",
          "same_path": true,
          "bind": "fn"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Handler",
          "canonical_key": {
            "template": "gin:handler:{fn.definition.name}"
          },
          "attributes": {
            "handler_name": {
              "kind": "field_ref",
              "field": "fn.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        }
      ],
      "coverage_note": "A free function taking *gin.Context is a gin handler; the parameter-shape carrier is emitted on the declaration's own span, so a same-span join reaches the function with no Pack field."
    },
    {
      "id": "gin.handler.method",
      "match": [
        {
          "kind": "fact_kind",
          "value": "definition.parameter_shape_candidate"
        },
        {
          "kind": "path_glob",
          "field": "definition.name",
          "pattern": "**gin.Context*"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.method",
          "relation": "same",
          "same_path": true,
          "bind": "fn"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.receiver_candidate",
          "relation": "same",
          "same_path": true,
          "bind": "ctrl"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Handler",
          "canonical_key": {
            "template": "gin:handler:{fn.definition.name}"
          },
          "attributes": {
            "handler_name": {
              "kind": "field_ref",
              "field": "fn.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Controller",
          "canonical_key": {
            "template": "gin:controller:{path}:{ctrl.definition.name}"
          },
          "attributes": {
            "controller_name": {
              "kind": "field_ref",
              "field": "ctrl.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "declares",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:controller:{path}:{ctrl.definition.name}"
          },
          "target": {
            "kind": "current"
          }
        }
      ],
      "coverage_note": "A method taking *gin.Context is a gin handler and its receiver type is the controller that declares it."
    },
    {
      "id": "gin.handler.request_binding",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "Bind",
            "BindJSON",
            "BindXML",
            "BindYAML",
            "BindTOML",
            "BindQuery",
            "BindUri",
            "BindHeader",
            "BindWith",
            "MustBindWith",
            "ShouldBind",
            "ShouldBindJSON",
            "ShouldBindXML",
            "ShouldBindYAML",
            "ShouldBindTOML",
            "ShouldBindQuery",
            "ShouldBindUri",
            "ShouldBindHeader",
            "ShouldBindWith",
            "ShouldBindBodyWith"
          ]
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gin-"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "scope.function_body",
          "relation": "within",
          "same_path": true,
          "bind": "fn"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "RequestBinding",
          "canonical_key": {
            "template": "gin:request-binding:{path}:{source.start}"
          },
          "attributes": {
            "binder": {
              "kind": "field_ref",
              "field": "definition.name"
            },
            "bound_argument": {
              "kind": "field_ref",
              "field": "call.arg0_text"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Handler",
          "canonical_key": {
            "template": "gin:handler:{fn.definition.name}"
          },
          "attributes": {
            "handler_name": {
              "kind": "field_ref",
              "field": "fn.definition.name"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "binds_request",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:handler:{fn.definition.name}"
          },
          "target": {
            "kind": "current"
          }
        }
      ],
      "coverage_note": "c.ShouldBindJSON(&req): which handler parses a request body, with which binder, and into which variable -- the first argument as written."
    },
    {
      "id": "gin.middleware.factory",
      "match": [
        {
          "kind": "fact_kind",
          "value": "definition.return_type_candidate"
        },
        {
          "kind": "path_glob",
          "field": "definition.name",
          "pattern": "**gin.HandlerFunc*"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.function",
          "relation": "same",
          "same_path": true,
          "bind": "fn"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Middleware",
          "canonical_key": {
            "template": "gin:middleware:{fn.definition.name}"
          },
          "attributes": {
            "middleware_name": {
              "kind": "field_ref",
              "field": "fn.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        }
      ],
      "coverage_note": "A function returning gin.HandlerFunc is a middleware factory."
    },
    {
      "id": "gin.middleware.use_function_result",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.function"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gin-"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "call.method",
          "relation": "within",
          "same_path": true,
          "bind": "use",
          "where": [
            {
              "kind": "field_equals",
              "field": "definition.name",
              "value": "Use"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "scope.function_body",
          "relation": "within",
          "same_path": true,
          "bind": "host"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Middleware",
          "canonical_key": {
            "template": "gin:middleware:{definition.name}"
          },
          "attributes": {
            "middleware_name": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Router",
          "canonical_key": {
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "attributes": {
            "router_name": {
              "kind": "field_ref",
              "field": "host.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "configured_by",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "target": {
            "kind": "current"
          },
          "attributes": {
            "installed_as": {
              "kind": "field_ref",
              "field": "use.call.arg0_text"
            },
            "via_receiver": {
              "kind": "field_ref",
              "field": "use.receiver"
            },
            "source_form": "local_function"
          }
        }
      ],
      "coverage_note": "r.Use(Auth()): the middleware installed on a router, named by the constructor called inside Use, with the argument as written carried on the edge."
    },
    {
      "id": "gin.middleware.use_package_result",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gin-"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "call.method",
          "relation": "within",
          "same_path": true,
          "bind": "use",
          "where": [
            {
              "kind": "field_equals",
              "field": "definition.name",
              "value": "Use"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "scope.function_body",
          "relation": "within",
          "same_path": true,
          "bind": "host"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Middleware",
          "canonical_key": {
            "template": "gin:middleware:{definition.name}"
          },
          "attributes": {
            "middleware_name": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Router",
          "canonical_key": {
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "attributes": {
            "router_name": {
              "kind": "field_ref",
              "field": "host.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "configured_by",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "target": {
            "kind": "current"
          },
          "attributes": {
            "installed_as": {
              "kind": "field_ref",
              "field": "use.call.arg0_text"
            },
            "via_receiver": {
              "kind": "field_ref",
              "field": "use.receiver"
            },
            "source_form": "package_function"
          }
        }
      ],
      "coverage_note": "r.Use(cors.Default()): the middleware installed on a router, named by the constructor called inside Use, with the argument as written carried on the edge."
    },
    {
      "id": "gin.request_model.binding_tag",
      "match": [
        {
          "kind": "fact_kind",
          "value": "definition.tag_candidate"
        },
        {
          "kind": "path_glob",
          "field": "definition.name",
          "pattern": "**binding:*"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.field",
          "relation": "same",
          "same_path": true,
          "bind": "fld"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.struct",
          "relation": "within",
          "same_path": true,
          "bind": "model"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "ValidatedField",
          "canonical_key": {
            "template": "gin:validated-field:{path}:{model.definition.name}:{fld.definition.name}"
          },
          "attributes": {
            "field_name": {
              "kind": "field_ref",
              "field": "fld.definition.name"
            },
            "struct_tag": {
              "kind": "field_ref",
              "field": "definition.name"
            },
            "model_name": {
              "kind": "field_ref",
              "field": "model.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "RequestModel",
          "canonical_key": {
            "template": "gin:request-model:{path}:{model.definition.name}"
          },
          "attributes": {
            "model_name": {
              "kind": "field_ref",
              "field": "model.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "validates",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:request-model:{path}:{model.definition.name}"
          },
          "target": {
            "kind": "current"
          }
        }
      ],
      "coverage_note": "A struct field carrying a binding: tag is validated by gin's binder; the struct is the request model."
    },
    {
      "id": "gin.route.handle_verb",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "Handle",
            "Match"
          ]
        },
        {
          "kind": "field_present",
          "field": "call.arg0"
        },
        {
          "kind": "field_present",
          "field": "call.last_arg"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gin-"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "scope.function_body",
          "relation": "within",
          "same_path": true,
          "bind": "host"
        },
        {
          "kind": "field_present",
          "field": "call.arg1_text"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Route",
          "canonical_key": {
            "template": "http:{method}:{normalized_route}"
          },
          "attributes": {
            "method": {
              "kind": "field_ref",
              "field": "call.arg0_text"
            },
            "handler_name": {
              "kind": "field_ref",
              "field": "call.last_arg"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            },
            "route": {
              "kind": "field_ref",
              "field": "call.arg1_text"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Handler",
          "canonical_key": {
            "template": "gin:handler:{call.last_arg_name}"
          },
          "attributes": {
            "handler_name": {
              "kind": "field_ref",
              "field": "call.last_arg"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Router",
          "canonical_key": {
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "attributes": {
            "router_name": {
              "kind": "field_ref",
              "field": "host.definition.name"
            },
            "declared_in": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "handles",
          "source": {
            "kind": "current"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "gin:handler:{call.last_arg_name}"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "mounts",
          "source": {
            "kind": "by_canonical_key",
            "template": "gin:router:{path}:{host.definition.name}"
          },
          "target": {
            "kind": "current"
          },
          "attributes": {
            "registered_in": {
              "kind": "field_ref",
              "field": "host.definition.name"
            },
            "via_receiver": {
              "kind": "field_ref",
              "field": "receiver"
            }
          }
        }
      ],
      "coverage_note": "`r.Handle(\"GET\", \"/legacy\", h)` and `r.Match([]string{...}, \"/x\", h)`: the verb is the first argument and the URL the second, so the route joins the same key space as every other registration rather than being located by the offset it was written at."
    },
    {
      "id": "gin.route.handler_reference",
      "match": [
        {
          "kind": "fact_kind",
          "value": "reference.member"
        },
        {
          "kind": "field_not_in",
          "field": "definition.name",
          "values": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
            "Any",
            "Handle",
            "Match",
            "Group",
            "Use",
            "Static",
            "StaticFile",
            "StaticFileFS",
            "StaticFS",
            "LoadHTMLGlob",
            "LoadHTMLFiles",
            "NoRoute",
            "NoMethod",
            "Run",
            "RunTLS"
          ]
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gin-"
            }
          ]
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "call.method",
          "relation": "within",
          "same_path": true,
          "bind": "reg",
          "where": [
            {
              "kind": "field_in",
              "field": "definition.name",
              "values": [
                "GET",
                "POST",
                "PUT",
                "PATCH",
                "DELETE",
                "HEAD",
                "OPTIONS",
                "Any"
              ]
            },
            {
              "kind": "field_present",
              "field": "call.arg0"
            }
          ]
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Route",
          "canonical_key": {
            "template": "http:{method}:{normalized_route}"
          },
          "attributes": {
            "method": {
              "kind": "field_ref",
              "field": "reg.definition.name"
            },
            "route": {
              "kind": "field_ref",
              "field": "reg.call.arg0_text"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Handler",
          "canonical_key": {
            "template": "gin:handler:{definition.name}"
          },
          "attributes": {
            "handler_name": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "handles",
          "source": {
            "kind": "current"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "gin:handler:{definition.name}"
          }
        }
      ],
      "coverage_note": "r.GET(\"/users/:id\", ctrl.GetUser): a handler written as a qualified selector is a reference.member inside the call's span, so the edge reaches the bare method name that gin.handler.method declares, in whatever file that declaration lives."
    },
    {
      "id": "gin.route.registration",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE",
            "HEAD",
            "OPTIONS",
            "Any"
          ]
        },
        {
          "kind": "field_present",
          "field": "call.arg0"
        },
        {
          "kind": "field_present",
          "field": "call.last_arg"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
