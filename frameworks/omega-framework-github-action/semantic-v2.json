        {
          "kind": "path_glob",
          "pattern": "**/.github/workflows/*.y*ml"
        },
        {
          "kind": "field_equals",
          "field": "definition.name",
          "value": "jobs"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Pipeline",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "ci:github:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "name": {
              "kind": "field_ref",
              "field": "path.stem"
            }
          }
        }
