        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "SwiftUI",
            "SwiftData",
            "WidgetKit",
            "Charts"
          ]
        },
        {
          "kind": "path_segment",
          "exclude": [
            "Pods",
            "Carthage",
            ".build",
            "DerivedData"
          ]
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "SwiftUIFile",
          "canonical_key": {
            "template": "swiftui:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "framework": "swiftui"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Dependency",
          "canonical_key": {
            "template": "swiftui:package:{definition.name}"
          },
          "attributes": {
            "package": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "depends_on",
          "source": {
            "kind": "by_canonical_key",
            "template": "swiftui:file:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "swiftui:package:{definition.name}"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "observed",
      "confidence": "exact",
      "coverage_note": "Which files are SwiftUI files and which Apple UI module each one imports. The module name is the import's own name, so no Pack field is needed."
    },
