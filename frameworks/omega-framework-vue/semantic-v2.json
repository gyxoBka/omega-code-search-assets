  "rules": [
    {
      "id": "vue.sfc.component.file",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "data.file"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.vue"
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Component",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "vue:component:{path}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "path.stem"
            },
            "file": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "ComponentName",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "vue:component-name:{path.stem}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "path.stem"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "declares_component",
          "source": {
            "kind": "by_canonical_key",
            "template": "vue:component:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "vue:component-name:{path.stem}"
          },
          "attributes": {
            "evidence": "single_file_component"
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "Every `.vue` single-file component, entered from the file itself so a template-only or script-only component is still a component. It carries no directory exclusion on purpose: ten rules address `vue:component:{path}` without one, and a minting rule narrower than the rules addressing it leaves their relations pointing at nothing."
    },
    {
      "id": "vue.pages.route",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "data.file"
        },
        {
          "kind": "path_glob",
          "pattern": "**/pages/**/*.vue"
        },
        {
          "kind": "path_segment",
          "exclude": [
            "node_modules",
            "dist",
            ".output",
            ".nuxt"
          ]
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.module",
          "current_field": "row_kind",
          "join_field": "row_kind",
          "where": [
            {
              "kind": "field_in",
              "field": "definition.name",
              "values": [
                "vue-router/auto-routes",
                "vue-router/auto",
                "unplugin-vue-router",
                "unplugin-vue-router/runtime",
                "virtual:generated-pages",
                "virtual:generated-pages-react",
                "~pages",
                "pages-generated"
              ]
            }
          ],
          "bind": "router_plugin"
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Route",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "vue:route:{normalized_file_route}"
          },
          "attributes": {
            "file": {
              "kind": "field_ref",
              "field": "path"
            },
            "component": {
              "kind": "field_ref",
              "field": "path.stem"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "renders",
          "source": {
            "kind": "by_canonical_key",
            "template": "vue:route:{normalized_file_route}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "vue:component:{path}"
          },
          "attributes": {
            "evidence": "file_based_route_under_pages"
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "high",
      "coverage_note": "Vue Router is configured, not file-based, so this rule fires only where a project has opted into file-based routing: the import.module join is a project-wide existence test (row_kind is 'fact' on every fact, so the join binds if any file anywhere imports one of the generated-routes specifiers of unplugin-vue-router or vite-plugin-pages). A Nuxt project imports none of them, so its pages/ tree is left to omega-framework-nuxt. {normalized_file_route} is the path below the pages/ root with index dropped and [id] normalized, so pages/users/[id].vue is vue:route:/users/{}."
    },
    {
