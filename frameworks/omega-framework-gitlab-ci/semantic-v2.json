    {
     "kind": "path_glob",
     "pattern": "**/.gitlab-ci.y*ml"
    },
    {
     "kind": "field_in",
     "field": "definition.name",
     "values": [
      "default",
      "include",
      "spec",
      "stages",
      "workflow"
     ]
    }
   ],
   "outputs": [
    {
     "kind": "entity_candidate",
     "entity_kind": "Pipeline",
     "canonical_key": {
      "kind": "canonical_key",
      "template": "ci:gitlab:pipeline:{path}"
     },
     "attributes": {
      "source_path": {
       "kind": "field_ref",
       "field": "path"
      }
     }
    }
   ],
   "evidence_class": "structurally_derived",
   "confidence": "exact"
