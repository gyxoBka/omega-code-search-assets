        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "BuildToolchain",
          "canonical_key": {
            "template": "pytorch-ext:toolchain:cuda"
          },
          "attributes": {
            "toolchain": {
              "kind": "literal",
              "value": "nvcc"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "compiled_by",
          "source": {
            "kind": "by_canonical_key",
            "template": "pytorch-ext:source:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "pytorch-ext:toolchain:cuda"
          },
          "attributes": {
            "header": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        }
