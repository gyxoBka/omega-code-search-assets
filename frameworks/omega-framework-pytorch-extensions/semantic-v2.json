        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "ATen/cuda/CUDAContext.h",
            "c10/cuda/CUDAGuard.h",
            "c10/cuda/CUDAStream.h",
            "cuda_runtime.h",
            "cuda_runtime_api.h",
            "cuda_fp16.h"
