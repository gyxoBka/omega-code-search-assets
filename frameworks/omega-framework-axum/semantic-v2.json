          ]
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "AxumApp",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "axum:app:{path.dir}"
          },
          "attributes": {
            "manifest": {
              "kind": "field_ref",
              "field": "path"
            },
            "dependency": {
              "kind": "field_ref",
              "field": "definition.name"
            },
            "framework": "axum"
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "The manifest states the dependency. The resolved version and the enabled feature set are Cargo's, not the overlay's."
