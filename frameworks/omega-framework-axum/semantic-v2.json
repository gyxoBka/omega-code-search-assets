        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "axum",
            "axum-extra",
            "axum-macros",
            "axum-server",
            "axum-core"
          ]
        },
        {
          "kind": "path_glob",
          "pattern": "**/Cargo.toml"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.config_table",
          "relation": "within",
          "same_path": true,
          "where": [
            {
              "kind": "field_in",
              "field": "definition.name",
              "values": [
                "dependencies",
                "dev-dependencies",
                "build-dependencies",
                "workspace.dependencies"
              ]
