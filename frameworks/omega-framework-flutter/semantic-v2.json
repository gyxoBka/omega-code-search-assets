{
  "schema_version": 2,
  "asset": "omega-framework-flutter",
  "selector": "framework:flutter",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "dart",
      "yaml"
    ],
    "required_packs": [
      "omega-dart",
      "omega-yaml"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "references",
      "data"
    ]
  },
  "evidence_inputs": [
    "existing_language_ir",
    "imports_bindings",
    "calls_members",
    "definitions_declarations",
    "structured_config"
