    "relations": [
      "configured_by",
      "declares_entrypoint",
      "declares_widget",
      "depends_on",
      "renders",
      "routes_to"
    ]
  },
  "rules": [
    {
      "id": "flutter.widget.declaration",
      "match": [
        {
          "kind": "fact_kind",
          "value": "relation.implements"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "StatelessWidget",
            "StatefulWidget",
            "State",
            "InheritedWidget",
            "InheritedModel",
            "InheritedNotifier",
            "ConsumerWidget",
            "ConsumerStatefulWidget",
            "ConsumerState",
            "HookWidget",
            "HookConsumerWidget",
            "StatefulHookConsumerWidget",
            "PreferredSizeWidget",
            "AnimatedWidget",
            "ImplicitlyAnimatedWidget",
            "LeafRenderObjectWidget",
            "SingleChildRenderObjectWidget",
            "MultiChildRenderObjectWidget",
            "RenderObjectWidget",
            "ProxyWidget",
            "CustomPainter",
            "CustomClipper",
            "StatefulShellRouteData",
            "GoRouteData"
          ]
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.dart"
        },
        {
          "kind": "fact_join_by_span",
          "fact_kind": "definition.class",
          "relation": "within",
          "same_path": true,
          "bind": "owner",
          "where": []
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Widget",
          "canonical_key": {
            "template": "flutter:widget:{path}:{owner.definition.name}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "owner.definition.name"
            },
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "widget_base": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "WidgetName",
          "canonical_key": {
            "template": "flutter:widget-name:{owner.definition.name}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "owner.definition.name"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "declares_widget",
          "source": {
            "kind": "by_canonical_key",
            "template": "flutter:widget-name:{owner.definition.name}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "flutter:widget:{path}:{owner.definition.name}"
          },
          "attributes": {
            "widget_base": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "Which classes in this project are Flutter widgets, which base each extends, and where. `extends StatelessWidget` is a relation.implements named after the supertype; the class that declares it is the definition.class whose span contains it. The WidgetName node is what a renders edge in another file addresses, because no Dart fact ties a construction to the file that declares the type."
    },
