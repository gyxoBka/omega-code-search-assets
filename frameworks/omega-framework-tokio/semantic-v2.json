      "id": "tokio.runtime-main.scoped-attribute",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "reference.rust_function_scoped_attribute_context"
        },
        {
          "kind": "field_equals",
          "field": "attribute_path",
          "value": "tokio::main"
        },
        {
          "kind": "field_present",
          "field": "function_name"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.rs"
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "RuntimeComponent",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "tokio:runtime:{path}:{function_name}"
          },
          "attributes": {
            "entry": {
              "kind": "field_ref",
              "field": "function_name"
            },
            "source_role": "fully-qualified-runtime-entry-attribute",
            "macro_execution_claimed": false
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "Source-authored fully-qualified attribute declaration only; macro expansion and runtime effects are not claimed."
    },
