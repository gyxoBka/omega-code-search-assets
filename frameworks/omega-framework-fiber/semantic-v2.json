  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "go"
    ],
    "required_packs": [
      "omega-go"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "imports",
      "references",
      "scopes"
    ]
  },
  "evidence_inputs": [
    "imports_bindings",
    "calls_members",
    "existing_language_ir"
  ],
  "emits": {
    "entities": [
      "Application",
      "Controller",
      "Dependency",
      "FiberFile",
      "Handler",
      "HandlerName",
      "Middleware",
      "Route",
      "RouteGroup",
      "RouteRegistrar",
