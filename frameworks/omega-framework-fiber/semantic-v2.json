{
  "schema_version": 2,
  "asset": "omega-framework-fiber",
  "selector": "framework:fiber",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "go"
    ],
    "required_packs": [
      "omega-go"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "imports",
      "references",
      "scopes"
    ]
  },
  "evidence_inputs": [
    "imports_bindings",
    "calls_members",
    "existing_language_ir"
  ],
  "emits": {
    "entities": [
      "Controller",
      "Dependency",
      "FiberFile",
      "Handler",
      "HandlerName",
      "Middleware",
      "Route",
      "RouteGroup",
      "RouteRegistrar",
      "Service",
      "StaticResource"
    ],
    "relations": [
      "configured_by",
      "declares",
      "depends_on",
      "handles",
      "mounts",
      "registers_route",
      "uses_resource"
    ]
  },
  "rules": [
    {
      "id": "fiber.dependency.import",
      "match": [
        {
          "kind": "fact_kind",
          "value": "import.package"
        },
        {
          "kind": "field_prefix",
          "field": "definition.name",
          "value": "github.com/gofiber/"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.go"
        },
        {
          "kind": "path_segment",
          "exclude": [
            "vendor",
            "testdata",
            "third_party"
          ]
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "FiberFile",
          "canonical_key": {
            "template": "fiber:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "framework": "fiber"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Dependency",
          "canonical_key": {
            "template": "fiber:package:{definition.name}"
          },
          "attributes": {
            "module": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "depends_on",
          "source": {
            "kind": "by_canonical_key",
            "template": "fiber:file:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "fiber:package:{definition.name}"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "observed",
      "confidence": "exact",
      "coverage_note": "Which files are Fiber files and which part of the Fiber stack each one pulls in -- the router itself, a middleware under .../middleware/*, a storage driver, a template engine, a contrib package. The module name is the import's own name, so omega-go needs no field for it, and this is the only fact that says a Go file is a Fiber file at all; every other rule in this file is gated on it."
    },
    {
      "id": "fiber.route.registration",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_in",
          "field": "definition.name",
          "values": [
            "Get",
            "Head",
            "Post",
            "Put",
            "Delete",
            "Connect",
            "Options",
            "Trace",
            "Patch",
            "All",
            "Add"
          ]
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.go"
        },
        {
          "kind": "path_segment",
          "exclude": [
            "vendor",
            "testdata",
            "third_party"
          ]
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "bind": "fiber_import",
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gofiber/"
