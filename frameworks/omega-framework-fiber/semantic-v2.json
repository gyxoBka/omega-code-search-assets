  "rules": [
    {
      "id": "fiber.app.construct",
      "match": [
        {
          "kind": "fact_kind",
          "value": "call.method"
        },
        {
          "kind": "field_equals",
          "field": "definition.name",
          "value": "New"
        },
        {
          "kind": "field_equals",
          "field": "receiver",
          "value": "fiber"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.go"
        },
        {
          "kind": "path_segment",
          "exclude": [
            "vendor",
            "testdata",
            "third_party"
          ]
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.package",
          "current_field": "path",
          "join_field": "path",
          "same_path": true,
          "bind": "fiber_import",
          "where": [
            {
              "kind": "field_prefix",
              "field": "definition.name",
              "value": "github.com/gofiber/"
            }
          ]
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Application",
          "canonical_key": {
            "template": "fiber:app:{path}:{source.start}"
          },
          "attributes": {
            "framework": "fiber",
            "file": {
              "kind": "field_ref",
              "field": "path"
            },
            "offset": {
              "kind": "field_ref",
              "field": "source.start"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "FiberFile",
          "canonical_key": {
            "template": "fiber:file:{path}"
          },
          "attributes": {
            "file": {
              "kind": "field_ref",
              "field": "path"
            },
            "framework": "fiber"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "declares",
          "source": {
            "kind": "by_canonical_key",
            "template": "fiber:file:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "fiber:app:{path}:{source.start}"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "candidate",
      "coverage_note": "fiber.New(): where the application is constructed. The receiver field now published on omega-go's call.method is what separates it from every other New() in the file."
    },
    {
