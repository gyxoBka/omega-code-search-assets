        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Route",
          "canonical_key": {
            "template": "fiber:route:{path}:{source.start}"
          },
          "attributes": {
            "method": {
              "kind": "field_ref",
              "field": "definition.name"
            },
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "offset": {
              "kind": "field_ref",
              "field": "source.start"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "FiberFile",
          "canonical_key": {
            "template": "fiber:file:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "framework": "fiber"
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "declares",
          "source": {
            "kind": "by_canonical_key",
            "template": "fiber:file:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "fiber:route:{path}:{source.start}"
          },
          "attributes": {
            "method": {
              "kind": "field_ref",
              "field": "definition.name"
            }
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "high",
      "coverage_note": "Where an HTTP route is registered, and under which verb. Fiber spells every registration as a method on the app or on a group -- app.Get, api.Post, app.Add -- so one rule over call.method covers all eleven verbs that eight per-verb, per-import-spelling rules used to cover. The registration site is identified by its byte offset because omega-go publishes no call argument, so the path literal is not reachable; see 'A field only the Pack can supply'."
    },
