        {
          "kind": "relation_candidate",
          "relation_kind": "declares",
          "source": {
            "kind": "by_canonical_key",
            "template": "fiber:handler-name:{fn.definition.name}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "fiber:handler:{path}:{fn.definition.name}"
          },
          "attributes": {
            "form": "function"
