    {
      "id": "astro.template.imported-component-render",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "data.astro_element"
        },
        {
          "kind": "field_present",
          "field": "name"
        },
        {
          "kind": "path_glob",
          "pattern": "**/*.astro"
        },
        {
          "kind": "fact_join_by_field",
          "fact_kind": "import.ecmascript_named_binding_context",
          "current_field": "name",
          "join_field": "local_name",
          "same_path": true,
          "bind": "component_import",
          "where": [
            {
              "kind": "field_present",
              "field": "module_source"
            }
          ]
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "ComponentReference",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "astro:component-ref:{path}:{name}"
          },
          "attributes": {
            "name": {
              "kind": "field_ref",
              "field": "name"
            },
            "source_only": true,
            "import_resolved": true
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "renders",
          "source": {
            "kind": "by_canonical_key",
            "template": "astro:component:{path}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "astro:component-ref:{path}:{name}"
          },
          "attributes": {
            "source_only": true,
            "import_resolved": true
          }
        }
      ],
      "evidence_class": "observed",
      "confidence": "exact"
    },
