        {
          "kind": "relation_candidate",
          "relation_kind": "uses_api",
          "source": {
            "kind": "current"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "astro:api-use:{path}:{source.start}"
          },
          "attributes": {
            "package": "astro",
            "source_only": true
          }
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact",
      "coverage_note": "Generic provenance-backed authored framework API use; specialized framework semantics are added by dedicated rules."
