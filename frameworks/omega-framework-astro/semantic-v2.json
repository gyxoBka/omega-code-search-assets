   "hydrates",
   "links_to_element",
   "provides_paths",
   "renders",
   "renders_value",
   "route_to_component"
  ]
 },
 "rules": [
  {
   "id": "astro.component.file",
   "snapshot": true,
   "match": [
    {
     "kind": "fact_kind",
     "value": "data.file"
    },
    {
     "kind": "path_glob",
     "pattern": "**/*.astro"
    }
   ],
   "guards": [],
   "outputs": [
    {
     "kind": "entity_candidate",
     "entity_kind": "AstroComponent",
     "canonical_key": {
      "kind": "canonical_key",
      "template": "astro:component:{path}"
     },
     "attributes": {
      "path": {
       "kind": "field_ref",
       "field": "path"
      }
     }
    }
   ],
   "evidence_class": "structurally_derived",
   "confidence": "exact",
   "coverage_note": "One hub entity per authored .astro file; what it is -- a page, a renderer of components, a declarer of slots -- is carried by the relations that point at it."
  },
  {
   "id": "astro.page.route",
   "snapshot": true,
   "match": [
    {
     "kind": "fact_kind",
     "value": "data.file"
    },
    {
     "kind": "path_glob",
     "pattern": "**/src/pages/**/*.astro"
    }
   ],
   "guards": [],
   "outputs": [
    {
     "kind": "entity_candidate",
     "entity_kind": "Route",
     "canonical_key": {
      "kind": "canonical_key",
      "template": "astro:page:{normalized_file_route}"
     },
     "attributes": {
      "file": {
       "kind": "field_ref",
       "field": "path"
      },
      "framework": "astro",
      "router": "src/pages"
     }
    },
    {
     "kind": "relation_candidate",
     "relation_kind": "route_to_component",
     "source": {
      "kind": "by_canonical_key",
      "template": "astro:page:{normalized_file_route}"
     },
     "target": {
      "kind": "by_canonical_key",
      "template": "astro:component:{path}"
     },
     "attributes": {}
    }
   ],
   "evidence_class": "structurally_derived",
   "confidence": "exact"
  },
