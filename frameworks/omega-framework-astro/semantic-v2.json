{
  "schema_version": 2,
  "asset": "omega-framework-astro",
  "selector": "framework:astro",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "astro",
      "javascript",
      "typescript"
    ],
    "required_packs": [
      "omega-astro",
      "omega-javascript",
      "omega-typescript"
    ],
    "required_capabilities": [
      "calls",
      "data",
      "definitions",
      "imports",
      "references"
    ]
  },
  "evidence_inputs": [
    "package_manifests",
    "file_paths",
    "directory_conventions",
    "imports_bindings",
    "config_files",
    "existing_language_ir"
  ],
  "emits": {
    "entities": [
      "ApiUse",
      "Component",
      "ComponentReference",
      "ContentCollection",
      "CookieAccess",
      "Dependency",
      "EndpointHandler",
      "GeneratorAccess",
      "Integration",
      "LocalsAccess",
      "Page",
      "ParamsAccess",
      "PropsAccess",
      "RedirectAccess",
      "RequestAccess",
      "Route",
      "SiteAccess",
      "StaticPathGenerator",
      "UrlAccess"
    ],
    "relations": [
      "depends_on",
      "handles",
      "renders",
      "route_to_component",
      "uses_api",
      "uses_context"
    ]
  },
  "rules": [
    {
      "id": "astro.page.route",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
          "value": "data.file"
        },
        {
          "kind": "path_glob",
          "pattern": "**/src/pages/**/*.astro"
        }
      ],
      "guards": [],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "Page",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "astro:page:{normalized_file_route}"
          },
          "attributes": {
            "route": {
              "kind": "normalize_route",
              "source": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Component",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "astro:component:{path}"
          },
          "attributes": {
            "path": {
              "kind": "field_ref",
              "field": "path"
            },
            "role": "page"
          }
        },
        {
          "kind": "entity_candidate",
          "entity_kind": "Route",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "http:*:{normalized_file_route}"
          },
          "attributes": {
            "path": {
              "kind": "normalize_route",
              "source": "path"
            }
          }
        },
        {
          "kind": "relation_candidate",
          "relation_kind": "route_to_component",
          "source": {
            "kind": "by_canonical_key",
            "template": "http:*:{normalized_file_route}"
          },
          "target": {
            "kind": "by_canonical_key",
            "template": "astro:page:{normalized_file_route}"
          },
          "attributes": {}
        }
      ],
      "evidence_class": "structurally_derived",
      "confidence": "exact"
    },
    {
      "id": "astro.component.authored-file",
      "snapshot": true,
      "match": [
        {
          "kind": "fact_kind",
