 "emits": {
  "entities": [
   "Asset",
   "AstroComponent",
   "AstroConfig",
   "ComponentReference",
   "ContentCollection",
   "ContentConfig",
   "ElementAnchor",
   "EndpointHandler",
   "FrontmatterValue",
   "HydratedComponent",
   "Integration",
   "Middleware",
   "Route",
   "Slot",
   "SlotFill",
   "StaticPathGenerator"
