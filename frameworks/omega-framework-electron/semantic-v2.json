      "kind": "by_canonical_key",
      "template": "electron:file:{path}"
     },
     "target": {
      "kind": "by_canonical_key",
      "template": "electron:module:{definition.name}"
     },
     "attributes": {}
    }
   ],
   "evidence_class": "observed",
   "confidence": "exact",
   "coverage_note": "Which files are Electron code and which Electron entry point they pull in - electron, electron/main, electron/renderer, @electron/remote - from the specifier as written. The Pack states require(\"electron\") under the same import.module kind as an ESM import, so both module systems are covered by this one rule."
