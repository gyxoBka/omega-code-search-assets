{
  "schema_version": 2,
  "asset": "omega-framework-laravel",
  "selector": "framework:laravel",
  "maturity_target": "semantic-overlay-full",
  "host": {
    "languages": [
      "php",
      "blade"
    ],
    "required_packs": [
      "omega-php",
      "omega-blade"
    ],
    "required_capabilities": [
      "calls",
      "definitions",
      "references",
      "scopes",
      "types"
    ]
