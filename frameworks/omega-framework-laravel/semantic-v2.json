          "fact_kind": "definition.class",
          "relation": "within",
          "same_path": true,
          "bind": "cls"
        }
      ],
      "outputs": [
        {
          "kind": "entity_candidate",
          "entity_kind": "LaravelClass",
          "canonical_key": {
            "kind": "canonical_key",
            "template": "laravel:class:{cls.definition.name}"
          },
          "attributes": {
            "class": {
              "kind": "field_ref",
              "field": "cls.definition.name"
            },
            "file": {
              "kind": "field_ref",
              "field": "path"
            }
          }
        },
        {
          "kind": "entity_candidate",
