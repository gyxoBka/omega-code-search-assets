 },
 "evidence_inputs": [
  "file_paths",
  "directory_conventions",
  "imports_bindings",
  "calls_members",
  "existing_language_ir"
 ],
 "emits": {
  "entities": [
   "Component",
   "Composable",
   "Dependency",
