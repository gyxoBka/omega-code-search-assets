   "vue",
   "typescript",
   "javascript"
  ],
  "required_packs": [
   "omega-vue",
   "omega-typescript",
   "omega-javascript"
  ],
  "required_capabilities": [
   "calls",
   "data",
   "definitions",
   "imports",
   "references"
