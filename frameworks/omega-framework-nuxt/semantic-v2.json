 "rules": [
  {
   "id": "nuxt.page",
   "match": [
    {
     "kind": "fact_kind",
     "value": "scope.template_block"
    },
    {
     "kind": "path_glob",
     "pattern": "**/pages/**/*.vue"
    }
   ],
   "outputs": [
    {
     "kind": "entity_candidate",
     "entity_kind": "Page",
     "canonical_key": {
      "template": "nuxt:page:{path}"
     },
     "attributes": {
      "file": {
       "kind": "field_ref",
       "field": "path"
      },
      "router": "pages"
     }
    },
    {
     "kind": "entity_candidate",
     "entity_kind": "Route",
     "canonical_key": {
      "template": "http:*:{normalized_file_route}"
     },
     "attributes": {
      "file": {
       "kind": "field_ref",
       "field": "path"
      },
      "framework": "nuxt",
      "router": "pages",
      "runtime": "vue-router"
     }
    },
    {
     "kind": "entity_candidate",
     "entity_kind": "NuxtFile",
     "canonical_key": {
      "template": "nuxt:file:{path}"
     },
     "attributes": {
      "path": {
       "kind": "field_ref",
       "field": "path"
      }
     }
    },
    {
     "kind": "relation_candidate",
     "relation_kind": "handles",
     "source": {
      "kind": "by_canonical_key",
      "template": "http:*:{normalized_file_route}"
     },
     "target": {
      "kind": "by_canonical_key",
      "template": "nuxt:page:{path}"
     },
     "attributes": {}
    },
    {
     "kind": "relation_candidate",
     "relation_kind": "contains",
     "source": {
      "kind": "by_canonical_key",
      "template": "nuxt:file:{path}"
     },
     "target": {
      "kind": "by_canonical_key",
      "template": "nuxt:page:{path}"
     },
     "attributes": {}
    }
   ],
   "evidence_class": "structurally_derived",
   "confidence": "exact",
   "coverage_note": "A page of the file router: the URL its path under pages/ spells, and the single-file component that serves it. The entry fact is the SFC's own <template> block, which omega-vue emits once per page file."
  },
