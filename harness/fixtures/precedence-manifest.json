{
  "schema_version": 2,
  "entries": [
    {
      "id": "claude",
      "command": "claude",
      "env": {
        "CLAUDE_CONFIG_DIR": "home/claude-custom"
      },
      "directories": [
        "home/claude-custom"
      ],
      "expected_targets": {
        "mcp": [
          "home/claude-custom/.claude.json"
        ]
      },
      "definition_version": "1.0.0"
    },
    {
      "id": "codex",
      "command": "codex",
      "env": {
        "CODEX_HOME": "home/codex-custom"
      },
      "directories": [
        "home/codex-custom"
      ],
      "expected_targets": {
        "config": [
          "home/codex-custom/config.toml"
        ],
        "agents": [
          "home/codex-custom/AGENTS.md"
        ]
      },
      "definition_version": "1.0.0"
    },
    {
      "id": "opencode",
      "command": "opencode",
      "env": {
        "OPENCODE_CONFIG": "home/opencode-explicit.jsonc",
        "OPENCODE_CONFIG_DIR": "home/opencode-custom"
      },
      "directories": [
        "home/opencode-custom"
      ],
      "files": {
        "home/opencode-explicit.jsonc": "{}\n"
      },
      "expected_targets": {
        "main_config": [
          "home/opencode-explicit.jsonc"
        ],
        "agents_md": [
          "home/opencode-custom/AGENTS.md"
        ]
      },
      "definition_version": "1.1.0"
    },
    {
      "id": "opencode",
      "command": "opencode",
      "env": {},
      "directories": [
        "home/.config/opencode"
      ],
      "files": {
        "home/.config/opencode/opencode.jsonc": "{}\n",
        "home/.config/opencode/opencode.json": "{}\n"
      },
      "expected_targets": {
        "main_config": [
          "home/.config/opencode/opencode.jsonc"
        ]
      },
      "definition_version": "1.1.0"
    },
    {
      "id": "cline",
      "command": "cline",
      "env": {
        "CLINE_DATA_DIR": "home/cline-custom-data"
      },
      "directories": [
        "home/.cline",
        "home/cline-custom-data"
      ],
      "expected_targets": {
        "mcp_primary": [
          "home/.cline/mcp.json"
        ],
        "mcp_data": [
          "home/cline-custom-data/settings/cline_mcp_settings.json"
        ]
      },
      "definition_version": "1.1.0"
    },
    {
      "id": "hermes",
      "command": "hermes",
      "env": {
        "HERMES_HOME": "home/hermes-custom"
      },
      "directories": [
        "home/hermes-custom"
      ],
      "expected_targets": {
        "config": [
          "home/hermes-custom/config.yaml"
        ]
      },
      "definition_version": "1.1.0"
    },
    {
      "id": "vscode",
      "command": "code",
      "env": {},
      "directories": [
        "host-config/Code/User/profiles/one",
        "host-config/Code/User/profiles/two"
      ],
      "expected_targets": {
        "default_mcp": [
          "host-config/Code/User/mcp.json"
        ],
        "profile_mcp": [
          "host-config/Code/User/profiles/one/mcp.json",
          "host-config/Code/User/profiles/two/mcp.json"
        ]
      },
      "definition_version": "1.0.0"
    }
  ]
}
