 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "This grammar spells a definition's header as an ordinary call: `def foo(a, b)` contains the call node `foo(a, b)`, and a tree-sitter query cannot look at a node's parent, so every function clause also reports one call to itself at its own header."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is named as it is written. `Acct.get(id)` after `alias MyApp.Accounts, as: Acct` is recorded against `Acct`, not `MyApp.Accounts`, and a call through a module held in a variable or built by `apply/3` names the function only."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "types"
   ],
   "reason": "A struct has no name of its own: `defstruct` gives the fields of the module it sits in, and that module is the struct. Only the field names are declared, and they are not qualified by the module, because the query cannot reach it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "imports"
   ],
   "reason": "Macros are not expanded. The functions, callbacks and attributes that `use Foo` injects through `Foo.__using__/1`, and anything built inside `quote`, are declared in no file that uses them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A sigil is opaque. Names used inside `~H` and `~F` templates, `~r` regexes or `~S` strings are not stated, and a string with interpolation is read up to its first `#{`."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "tests"
   ],
   "reason": "A test is named by its description string, which says nothing a resolver can match; the unit under test is read only from a module named `<Module>Test`, and `describe` blocks and `setup` callbacks are not stated at all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call written without a module prefix is not stated: this grammar spells a module attribute with the same node shape as a local call, and a query cannot tell them apart. A piped call and a remote call are stated."
  }
 ],
 "legacy_rules": []
