 "decoders": [],
 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Parameters, and a local variable written inside a function body, are not declared: the name binds for one body and resolves to nothing outside it. A callable carries its parameter list as a shape, not as a declaration per parameter."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A type is recorded by the identifier as spelled. An import prefix is not applied and a typedef is not expanded, so `p.Widget`, `Widget` and an alias of it are three different names here, and a generic's type arguments are not part of the name."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call is recorded by the name written at the call site. The receiver's static type is not resolved, so `a.close()` and `b.close()` are the same call here; a call through a function-typed variable, a tear-off or `noSuchMethod` is not recorded at all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "`show` and `hide` are recorded alike, as the symbols they name, and the symbols a library exports without listing them are not enumerated. A conditional import is recorded by its default URI; which configuration the compiler picks is not known here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A library split with `part`/`part of` is recorded as a dependency between the files, not merged: a declaration made in one part is not a declaration of the library in another, and a private `_name` is not scoped to the library it belongs to."
  }
 ],
 "legacy_rules": []
