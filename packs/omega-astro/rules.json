 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "The frontmatter and the `<script>` are parsed by the TypeScript Pack through the injections, so what this file imports, the props it reads off `Astro.props` and the functions it defines are stated there and not here. A component tag resolves only if its import sits in the same file."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Nothing here declares the component this file itself is. An `.astro` file is named by its path, and a Pack expression cannot read the path, so `<Card />` in another file has no declaration in `Card.astro` to resolve onto."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "An expression in `{...}` is stated only when it is a single identifier. `{post.data.title}`, `{items.map(...)}` and a template literal are one `raw_text` token to this grammar, so what they reference is not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Only the presence of a `client:` directive is stated, not its value, so `client:only=\"react\"` does not say which renderer hydrates the component, and `client:media` does not say at which width."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "The page's prose is not stated. A `<title>` or heading in an Astro file is usually an interpolation of a frontmatter value rather than a text node, so no element's text is named here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A URL is taken verbatim from the attribute. It is not resolved against Astro's `src/`, `public/` or alias layout, so the name stated is the text written, not a file in the repository."
  }
 ],
