 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "This grammar has no node for a build stage's extent: every instruction is a direct child of the file, so a FROM declaration ends at its own line and nothing encloses the instructions that follow it. A COPY --from, a RUN --mount or a ${VAR} written inside a stage therefore has no owning declaration, and the host builds an edge only from a mention that has one. Those references are stated and are findable by name, but no relation is drawn from the stage that contains them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "An image reference is stated as its repository name alone: FROM node:20-alpine is stated as node, and the tag, the digest and the registry qualifier are not part of it, so two stages pinned to different tags of one image are one reference. No expansion is evaluated either, so FROM ${REGISTRY}/app is stated with the dollar sign in it and an ARG that names the whole image reaches nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A COPY or ADD path is stated exactly as written and is never resolved against the build context: a glob, a dot and a path relative to a WORKDIR name no file here. The destination path is stated beside the source because this grammar gives both the same path node and only their order tells them apart; an absolute destination carries no name the host will keep, but a relative one is stated as if it were a source."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "What a RUN does is not a fact of this Pack. Its shell body is handed to the bash Pack as an injection and stated there, so packages installed, users created and files written by a RUN are invisible here, and so is anything a heredoc builds."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "CMD, ENTRYPOINT and SHELL in their exec form are an argument vector, not a name, and are not stated; in their shell form they reach the bash injection instead. STOPSIGNAL, MAINTAINER, HEALTHCHECK's own options and the cross-build instructions expose no named node in this grammar, so their values cannot be captured at all."
  }
 ],
 "legacy_rules": []
