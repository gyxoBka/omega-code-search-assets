 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references",
    "types",
    "imports"
   ],
   "reason": "A name is stored as its last segment, so `App\\Models\\User`, `use App\\Models\\User` and a later `User` are one name here. Two classes of the same short name in different namespaces are not told apart, and `use` is not applied: nothing binds an unqualified mention to the namespace it was imported from."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only visibility is carried onto a declaration. PHP allows several other modifiers on one declaration (`final readonly class`, `abstract public static function`) and an attribute keeps one value, so `abstract`, `final`, `static` and `readonly` are not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call or a class named through a variable is not stated: `$handler()`, `new $class`, `$obj->$method()` and `call_user_func('f')` carry their target in a value, and `self`, `static` and `parent` name whichever class is running, which this Pack cannot see."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A trait `use` is recorded, but the members a class gains from a trait or a parent are not declared on that class, and `insteadof`/`as` renaming inside a `use` block is not applied."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "`include` and `require` are recorded only when the path is a literal string; the usual `__DIR__ . '/x.php'` form names no file here, and no path is resolved against the filesystem or an autoloader."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "bindings",
    "definitions"
   ],
   "reason": "Ordinary variables are not stated. Parameters, promoted properties, `global` declarations and a closure's `use` clause are; every other `$x` in a function body is not, because a bare variable capture stores each file's own text rather than answering a question."
  }
 ],
 "legacy_rules": []
}
