  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "calls",
        "references"
      ],
      "reason": "A call is stated under the name as written. `obj.method()` is a call to `method` with the receiver unknown, because Python binds an attribute at run time; a call made through a variable that holds a class, through `functools.partial`, or through `getattr` is not stated at all."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "An attribute that is read rather than called (`conn.timeout`) is not emitted. The grammar gives a read and a callee the same `attribute` node, Python supplies no static type for the receiver, and a bare member name would resolve against every declaration of that name in the repository."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "bindings",
        "scopes"
      ],
      "reason": "A name bound inside a function body -- by assignment, by a `for` target, by `with ... as`, by `except ... as`, by a comprehension, by the walrus operator or by a `match` case -- is not declared. Only module-level and class-body assignments are. Parameters are stated as the function's parameter shape, not as names of their own, and a lambda's parameters not at all."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "An attribute assigned on `self` inside `__init__` is not declared as a member of the class: the assignment target is an `attribute`, and the Pack does not resolve what `self` is bound to."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "imports"
      ],
      "reason": "An import names the module path exactly as written, leading dots and all. Turning `from . import x` or `import a.b.c` into a file means knowing `sys.path` and the package layout, which the program itself can change. `from x import *` binds names that are nowhere in the source, so nothing it introduces is declared."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "types"
      ],
      "reason": "An annotation is stated as a mention of each type name it contains, including nested ones. A string annotation (`\"Model\"`), a `TypeVar` bound and anything computed are not. `type X = ...` also produces a mention of `X` over its own left side, because the grammar gives the alias's left side the same `type` node it gives a use."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "tests"
      ],
      "reason": "A test is linked to what it covers by its name alone: `test_parse_header` to `parse_header`, `TestParser` to `Parser`. A test whose name does not follow the convention is not linked, and the assertions inside a test body are not stated."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "scopes"
      ],
      "reason": "A decorator can replace what it decorates -- `@property`, a class decorator that returns a different class, a metaclass. The declaration is stated as it is written; what the decorator makes of it at import time is run-time behaviour."
    }
  ],
  "legacy_rules": []
