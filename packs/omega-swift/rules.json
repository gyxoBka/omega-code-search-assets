 "decoders": [],
 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call is named by the identifier written at the call site. Swift overload resolution, protocol witness dispatch and `AnyObject` dynamic dispatch are not performed, so one call name may correspond to several declarations, and a call made through a closure value or a key path names nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A property read or write spelled `a.b` outside call position is not recorded; only calls, type mentions, attributes and conformances are. `where is this property read` is therefore answered only where the property is called."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "definitions"
   ],
   "reason": "Type names are taken as written: a `typealias` is carried on its declaration but never expanded, generic parameters are not distinguished from concrete types, and a qualified name such as `Swift.Array` yields one mention per component."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Members written in an `extension` are declared inside the extension, which is recorded as depending on the extended type; they are not attached to the original type's declaration, and a conditional extension's `where` clause is not read."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Conditional compilation is not evaluated, so declarations in every `#if` branch are recorded; declarations produced by a macro expansion are not recorded at all, because only the macro's invocation is in the source."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A function's parameters are not declared and its signature is not reconstructed: only the written return type and the visibility modifier are carried on the declaration, so two overloads of one name differ here only by span."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A binding that is not a single name is not declared: a tuple destructuring such as `let (a, b) = pair`, a closure's captured or implicit parameters, a `case let` pattern binding and a generic type parameter all bind names that this Pack does not state."
  }
 ],
 "legacy_rules": []
}
