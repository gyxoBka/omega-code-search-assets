  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "A name is recorded as it is written. Kotlin resolves an unqualified name through the package, the explicit imports, the default imports and the receiver in scope, none of which this Pack applies, so `List` in two files may be two different types and is one name here."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A secondary constructor is not declared under a name of its own: `constructor(...)` carries no identifier the grammar exposes, so a class's constructors are reachable only through the class. Its parameters are declared."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "An inferred type is not recorded. `val x = foo()` states no type in the source, so only an explicitly written type is carried, and a declaration with none carries nothing."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "calls"
      ],
      "reason": "A call is named by its callee alone. The receiver of `x.foo()` is a value whose type this Pack does not infer, so overloads, extension functions and members of different types that share a name are one name; infix calls (`a to b`) and operator conventions (`a + b`, `a[i]`, `a()`) are not recorded as calls at all, because the grammar spells their operands and their operator the same way."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "imports"
      ],
      "reason": "`import a.b.*` binds no symbol here: the package it depends on is recorded, and the names it brings into the file are not. Kotlin's default imports (kotlin.*, kotlin.collections.* and the rest) are implicit and appear in no file, so they are recorded nowhere."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "`extends`, `implements` and `by` delegation are one relation here. Kotlin spells a superclass, a superinterface and a delegated interface in the same `delegation_specifier`, and telling them apart needs the declaration of the supertype, which is resolution."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "scopes"
      ],
      "reason": "A property accessor (`get()`/`set()`), an `init` block and an anonymous object expression declare no name, so they are neither declared nor given a region; code inside them is attributed to the enclosing declaration."
    }
  ],
