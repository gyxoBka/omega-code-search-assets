 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "Groovy binds method and property names at run time. A qualified call is recorded under its last segment with the receiver dropped, and members added by metaprogramming -- methodMissing, invokeMethod, @Delegate, ExpandoMetaClass, category classes -- are named by no syntax and so are not declared."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "data"
   ],
   "reason": "An identifier followed by a closure is declared as a configuration block under that identifier, and a map entry under its key. Which DSL the identifier belongs to -- Gradle, Jenkins, Spock or a project's own builder -- is a framework fact and is not stated here, so a block name is not linked to the plugin that defines it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports",
    "implements"
   ],
   "reason": "An import is recorded as the text of its path: `import a.b.*` binds no individual name, and a star import does not tell an unqualified type use where its type came from. A supertype is recorded as written, and this grammar puts `extends` and `implements` in the same field, so the two cannot be told apart."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Only type positions, annotations and call targets are recorded as references. A bare identifier read as a value -- a local, a field, a closure's implicit `it`, or a name interpolated into a GString -- is not, so 'where is this variable read' is not answered."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "scopes"
   ],
   "reason": "Only a class body and a method body are regions. A closure used as a block, a lambda or a Jenkins `steps { }` has no region of its own, so the extent of a configuration block is the span of its declaration rather than a scope."
  }
 ],
 "legacy_rules": []
}
