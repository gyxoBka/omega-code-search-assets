 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "bindings"
   ],
   "reason": "The content of `{...}` is one raw JavaScript or TypeScript token in this grammar. An expression is stated only when it is a single identifier, so `{items.filter(fn)}` and `{a ? b : c}` contribute no reference, and a destructured binding such as `{#each rows as {id, name}}` or `{:then {data}}` binds no name here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "`<script>` and `<style>` are handed to the JavaScript, TypeScript and CSS Packs by injection. Props declared with `$props()`, imports, stores, reactive state and CSS selectors are stated there and not by this Pack, so a component's own interface is only as complete as the injected Pack."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A component is recognised by the capital letter of its tag and reduced to the first segment of a dotted name, which is the value the script imported. `<svelte:component this={Chosen}>` and any other dynamically chosen component are not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "`{@const}` is named by the text before the first `=`, so a destructuring form declares one name spelled as its pattern rather than the names it introduces."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "definitions"
   ],
   "reason": "Plain HTML attributes, intrinsic lowercase elements, text, entities and comments are deliberately not stated: they name nothing a question resolves against. `bind:`, `class:` and `style:` are stated only through the identifier in their value."
  }
 ],
