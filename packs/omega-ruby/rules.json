  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "calls",
        "references"
      ],
      "reason": "A receiverless call with no arguments is parsed as a bare `identifier`, which is the same node a local variable read produces, so `foo` standing alone is not emitted as a call to `foo`. Only a call the grammar marks as `call` is stated."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "A constant is emitted as a reference wherever it appears, including in the `class` or `module` header that declares it: the grammar gives the declaring occurrence no node type of its own."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "Methods made at runtime by anything other than `define_method` and the `attr_*` family -- `class_eval`, `method_missing`, `Struct.new`, a DSL that builds names from strings -- are not declared, because their names do not exist in the source."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "Method visibility is not recorded. `private` and `protected` written with no arguments change a mode that persists over the rest of the body, and a Pack states facts about spans, not about an interpreter's running state."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "imports"
      ],
      "reason": "A require names the string as it is written. Resolving it to a file means searching `$LOAD_PATH`, which the program itself can change; only `require_relative` is anchored to the requiring file."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "Inheritance and mixins are linked only where the superclass or the `include`/`extend`/`prepend` argument is written as a constant. `Class.new(...)`, a module held in a variable and a conditionally applied mixin are not linked."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "scopes"
      ],
      "reason": "A qualified name is reduced to its last constant, so `A::B` and a second `B` under a different namespace are one name here; the Pack does not resolve Ruby's constant lookup path."
    }
  ],
  "legacy_rules": []
}
