 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A bare $variable read is not stated. PowerShell binds a variable by assignment, by a parameter, by a foreach header or as a class property, and the Pack declares all four; it does not emit a mention for every read, so \"everywhere this variable is used\" is not answered, only \"everywhere it is bound\"."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A command name is stated exactly as authored. PowerShell resolves it at run time through aliases, the function table, the module path and the PATH, so gci, dir and Get-ChildItem are three names for one command and the Pack does not unify them; a call through an expression, as in & $cmd or & (Get-Tool), names nothing static and is not stated at all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "Only Import-Module with a literal module name or path is stated. This grammar has no using statement, so `using module` and `using namespace` are not parsed at all; a module named by a variable, or required through a manifest's RequiredModules entry, is stated only as the hashtable entry it is written in."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A class member inherited from a base class or from a .NET type is not stated. The Pack records the base type as a relation.implements occurrence and stops there; resolving which members a class actually has requires loading the base type."
  }
 ],
 "legacy_rules": []
