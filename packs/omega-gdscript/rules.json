 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A `var` or `const` inside a function body is a local. This grammar spells a local and a class property with the same `variable_statement` node and reaches both through the `body` node that every block form shares, so only file-level and inner-class-level declarations are stated; locals, `for` loop variables and `match` pattern bindings are not."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "`$Sprite/Label`, `%Unique` and `^\"res://path\"` name nodes in a scene tree, not code. Omega indexes no `.tscn` or `.tres`, so a node path is not stated: it could resolve to nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "types"
   ],
   "reason": "A type mention is the identifier as written. Autoload singletons and consts bound by `preload` take their names from project settings and from another file's `class_name`, so a mention of one resolves only if that name is declared in indexed GDScript."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call reached through a variable, a `Callable`, `call(\"name\")`, `callv` or `emit_signal(\"name\")` names its target in a string or at runtime; only a syntactically named callee is stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "scopes"
   ],
   "reason": "A class body and a function body are the only regions stated. `if`, `for`, `while` and `match` bodies are unnamed blocks in this language, so a nested block's extent is not stated."
  }
 ],
 "legacy_rules": []
