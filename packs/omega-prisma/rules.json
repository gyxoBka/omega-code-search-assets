  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A field name inside @@id, @@unique, @@index or @relation(fields: [...], references: [...]) is matched by its bare spelling only: nothing binds `id` in `references: [id]` to the field of the model on the other side of that relation, so a field name several models share resolves onto all of them."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "Prisma's nine built-in scalar types are declared nowhere, so a field typed String, Int or DateTime carries that type on its own declaration and is not stated as a reference: there would be nothing for such a reference to reach."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "env(\"DATABASE_URL\") is named, not read: the environment is not consulted here, so a datasource url or a shadow database is a dependency on a variable name and never a connection string."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A /// documentation comment is a sibling of the block it documents in this grammar rather than a child of it, so nothing attaches a model's or a field's prose to the declaration it describes."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "This grammar accepts no block attribute inside an enum, so @@map or @@schema on an enum is a parse error and an enum's database name and schema are not stated, while a model's and a view's are."
    }
  ],
