 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is recorded under the name it is spelled with. Scala resolves that name with types the Pack does not have -- overloads, implicit conversions, extension methods and `apply` on a companion object all reach a method whose name is not the one written -- so a call names a candidate, not a target."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only a binding whose pattern is a single identifier is declared. Names bound by a destructuring `val (a, b) = p`, by a `case Foo(x) =>` clause or by a for-comprehension enumerator are not, and an anonymous `given` has no name to declare."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "A wildcard import records the package it names, not the members it brings into scope, and a `given` selector is not matched to the instances it imports."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "`extends` and `derives` record the supertype as it is spelled. Linearisation, self-types, mixin order and everything inherited transitively need the compiler's view of the class hierarchy and are not stated here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A field selection that is not applied -- `config.host` -- is not recorded as a reference to `host`. Scala's uniform access makes it indistinguishable from a parameterless call without types, so only applied selections are recorded, and those as calls."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Macros, `inline` expansion and compiler-generated members (case-class `apply`, `copy`, `unapply`, enum `values`) are not declared: nothing in the source spells them."
  }
 ],
