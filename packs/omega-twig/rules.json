 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "This grammar has no block structure: a template is a flat run of directives, so `{% block %}` and `{% endblock %}`, `{% macro %}` and `{% endmacro %}`, `{% for %}` and `{% endfor %}` are siblings. The extent of a block or a macro body is not known, no region is emitted, and nothing a template declares is recorded as being inside anything else."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A template's context is supplied by the PHP controller that renders it, so a variable read in `{{ }}`, in a loop's sequence or in a condition resolves to nothing unless a `{% set %}`, a `{% for %}` or a macro parameter declares that name in the same file."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "calls"
   ],
   "reason": "Filters, functions and tests are declared in PHP by a Twig extension, not in Twig. They are named as applied, and in a corpus of `.twig` files alone there is no declaration for any of them to resolve onto."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports",
    "references"
   ],
   "reason": "A template path is kept as written and is not resolved to a file: loader namespaces such as `@AcmeBundle/form.html.twig`, paths relative to a loader root, and a computed name such as `{% include page ~ '.html.twig' %}` -- which is not a string literal and is therefore stated as no dependency at all -- all name a template this Pack cannot locate."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only the first name of a multiple assignment or a multiple loop is declared: `{% set a, b = 1, 2 %}` and `{% for key, value in items %}` put every name in one unordered run of `variable` children beside the assigned expressions, and only the one anchored to the keyword can be told apart from them."
  }
 ],
 "legacy_rules": []
