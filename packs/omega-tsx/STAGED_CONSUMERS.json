{
  "schema_version": 1,
  "status": "staged-not-production",
  "extension_routing": {
    ".tsx": {
      "grammar": "omega-tsx",
      "pack": "omega-tsx",
      "parser_id": "tree-sitter-tsx",
      "activation": "after-real-wasm-and-query-certification"
    }
  },
  "framework_consumers": [
    {
      "framework": "omega-framework-react",
      "required_after_promotion": true,
      "reason": "React TSX component/render/prop/event semantics"
    },
    {
      "framework": "omega-framework-next-js",
      "required_after_promotion": true,
      "reason": "Next.js .tsx page/layout/component semantics"
    },
    {
      "framework": "omega-framework-vue",
      "required_after_promotion": false,
      "reason": "Vue projects may contain explicit TSX render/component files; only activate where .tsx files are independently detected"
    }
  ],
  "production_wiring": false,
  "promotion_requirements": [
    "real TSX grammar.wasm from pinned revision",
    "real node-types.json and hashes",
    "queries.scm compile against real TSX parser",
    "positive and boundary TSX fixtures",
    "consumer Framework fixture validation",
    "remove .omega-staged markers only after all gates pass"
  ]
}
