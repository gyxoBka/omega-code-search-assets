  "injections": [],
  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "The leaf of a member access is not stated on its own. tree-sitter-zig spells a method callee as the same field_expression as a field read, and a query cannot see a node's parent, so every `a.b` would be a call reported as a field. Only the base of the chain, a call's member and the `.x` of an initializer are named."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A const or var inside a function body is the same node as a container declaration, so locals are not declared and a mention of a local resolves to nothing. Only declarations directly inside a file, a struct, an enum, a union or an opaque are stated."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "types"
      ],
      "reason": "A Zig type is a comptime value, so a type produced by a call such as ArrayList(u8), by @This(), or by any comptime expression is not named. Only a type spelled as an identifier where the grammar puts a type is stated."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "imports"
      ],
      "reason": "An import is named only when @import is given a string literal. A computed path, and usingnamespace over anything but an identifier or a member access, leave the target unnamed."
    }
  ],
  "legacy_rules": []
