  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A TOML table is stated in the form it was written. [a.b], a separate [a] and [a.b], and a.b = { } all define the same effective table, and the Pack does not merge them; a question about the merged result must be asked of the tool that reads the file."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A value is carried with its key only when it is a scalar. An array or an inline table is stated by the names and keys it holds, so asking what such a key is set to returns its members, not its text."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A string listed in an array is stated under its own text. TOML has no syntax that says what such a string refers to, so a link to a declaration elsewhere is by name alone and a string that happens to match one is not proof of a dependency."
    }
  ],
