 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A name exists in R because something was assigned to it, and only assignment to a plain identifier is declared here. `assign(\"x\", v)`, `x$y <- v`, `x[[k]] <- v`, `attr(x, \"k\") <- v` and names created by `list2env` or `with` are not declarations of anything the Pack can see."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is stated by the name written at the call site. R dispatches S3 and S4 at run time, and `do.call`, `match.fun`, `get` and `UseMethod` name a function in a string, so the function those calls reach is not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Classes are taken from the literal first argument of `setClass`, `setRefClass`, `setGeneric` and `setMethod`. S3 is a naming convention, so `print.myclass` is an ordinary function here and nothing links it to a class, and R6 and S7 are package object systems, not language syntax."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "A package is recorded when `library` or `require` is given the name directly. `library(pkg, character.only = TRUE)` with the name in a variable, and a package declared only in DESCRIPTION or NAMESPACE, are not visible from an R source file."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "`x$col` and `obj@slot` state the member name only. A data frame column, a list element and an object field are spelled the same in R, so a member reference is not distinguished from a column name and usually has no declaration to resolve against."
  }
 ],
