  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A key is stated where it is written and nothing more is claimed about it. YAML carries no schema of its own, so the Pack cannot tell a container image from a job name, a dependency from a label, or a file path from free text; what a key means is the knowledge of the tool that reads the file."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A value is carried with its key only when it is a plain or quoted scalar. A key set to a mapping, a sequence, an alias or a block scalar is stated without a value, because what it is set to is the keys and scalars inside it, each of which is its own emission; asking what such a key is set to returns its members, not its text."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A key written with no value at all (`volumes:` with nothing after it) and an explicit key introduced by `?` are not stated, because a query cannot ask for the absence of a field and the ordinary forms would then be declared twice. Several documents separated by `---` in one file are also not separated: their top-level keys are stated as siblings."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "An alias is linked to the anchor of the same name, but the anchored node is not expanded and a merge key (`<<: *defaults`) is not applied, so the keys a mapping inherits from an anchor are not declared at the place that merges them."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A scalar listed in a sequence is stated under its own text and nothing else. YAML has no syntax that says what such a scalar refers to, so a link to a declaration elsewhere is by name alone: an image tag, a job name, a hostname and a file path are indistinguishable, and a match is not proof of a dependency."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references",
        "definitions"
      ],
      "reason": "A tag is stated as it is written. The `%TAG` shorthand is not expanded to its prefix, so `!e!thing` and the handle `!e!` it uses are two separate names, and the implicit typing YAML applies to untagged scalars (`yes` as a boolean, `1.0` as a float) is not inferred."
    }
  ],
