 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "calls"
   ],
   "reason": "A type or method name is recorded exactly as it is written. Imports, the current package and the implicit java.lang import are not applied, so `List` here and `java.util.List` there stay two names until the resolver merges them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call is recorded by the method's simple name. Overloads are not separated by argument types and the receiver's static type is not computed, so a call to `close()` is a mention of every `close` declared in the index."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only what the source file writes is declared. Members inherited from a supertype, and members the compiler generates -- a record's accessors and canonical constructor, an enum's `values()` and `valueOf()` -- are declared nowhere."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "An annotation is recorded as a mention of the annotation interface it names. Its element values are not read and meta-annotations are not expanded, so what an annotation configures is not stated here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Generics are recorded as written: type arguments are not substituted into a declaration, a type variable's bound is carried only as text in the type-parameter shape, and no instantiation of a generic type is a declaration of its own."
  }
 ],
 "legacy_rules": []
