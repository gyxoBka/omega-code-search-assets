 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A binding is named by the last segment of its attrpath, so `services.nginx.enable = true;` is declared as `enable`; the dotted prefix is not part of the name and two options ending in the same segment share it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "An attrpath segment may be an interpolation or a string, as in `\"${name}\" = value;`, and then the attribute is named only when Nix evaluates it; such bindings are not declared here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "`with expr;` brings an unknown set of attributes into scope, so a bare name inside its body may be an attribute of that set rather than a lexical binding, and matching it to a declaration by name may be wrong."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A path is recorded as the text written. Nix resolves it relative to the file, against NIX_PATH for `<name>` and against the store for a fetched path, so no dependency here names a file in this repository with certainty."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A Nix function is an ordinary value, so the callee of an application may be any expression; only applications whose callee is a bare name or an attribute path are stated as calls."
  }
 ],
