 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A command name is resolved by PATH, by an alias or by a shell function at run time. The Pack states the word as written, so a call links to a function declared in the repository and an external binary links to nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A command whose name is not a literal word -- `$tool run`, `\"${CMD[@]}\"`, `eval \"$line\"` -- is not stated at all, because the name exists only at run time."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "A `source` target is often computed, as in `source \"$(dirname \"$0\")/lib.sh\"`. The Pack states the argument text with its quotes stripped, so only a literal relative path can be matched against a file in the repository."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A variable read inside an arithmetic expansion or a `[[ ]]` test is written without a `$` and is nested arbitrarily deep in expression nodes, so only the `$name` and `${name}` forms are stated as references."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Bash functions have no parameter list: a function reads `$1`, `$2` and `$@` from its body, so no parameter shape, arity or return type is stated for a function definition."
  }
 ],
