 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "types"
   ],
   "reason": "This grammar has no node for `Class ... End Class`, `Property Get/Let/Set`, `Const`, `Set`, `Select Case`, `With`, `On Error` or `Option Explicit`. A class-based VBScript file does not parse into those constructs at all here, so no class, property or constant is declared, and a method on a VBScript class is not distinguished from a top-level Sub."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A call and an array subscript are the same syntax and this grammar gives both the `function_call` node, so `buffer(i)` read in an expression is stated as a call to `buffer`. A call is stated under the name as written: `obj.Method` is a call to `Method` with the receiver unknown, because VBScript binds a member at run time, and a call made through `CreateObject`, `Eval`, `Execute` or `GetRef` is not stated at all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "bindings"
   ],
   "reason": "A parameter is stated as part of its procedure's parameter shape, not as a name of its own, so a use of a parameter inside a body resolves against a declaration of that name elsewhere or against nothing. A name introduced only by assignment is the same: VBScript declares implicitly, so `x = 1` is stated as an assignment to `x`, not as a declaration of it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A member that is read rather than called (`conn.Timeout`) is not stated. The grammar gives a read and a callee the same `member_expression`, VBScript supplies no static type for a receiver, and a bare member name would resolve against every declaration of that name in the repository."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "types",
    "references"
   ],
   "reason": "A type is stated as a mention in two places only: `New MyClass`, and the dotted name of an `As Scripting.Dictionary`, of which only the last segment is taken. The intrinsic types the grammar spells as keywords (Integer, String, Object, Variant) are carried on the declaration they belong to but are not mentions, because nothing in a repository declares them. `New A.B` is parsed by this grammar as a member access on `New A`, so only `A` is stated for it. A `Declare` names its library as a dependency; the exported symbol behind an `Alias` is not stated."
  }
 ],
 "legacy_rules": []
