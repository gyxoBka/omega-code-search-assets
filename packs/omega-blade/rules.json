 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A view name and a component tag are stated as written. Laravel maps a dotted view name onto a file under `resources/views` and a component onto either a class or an anonymous view at run time, and the Pack does not know a project's view paths, so `@include('partials.header')` and `<x-forms.input/>` name a string, not a file."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A name built by a PHP expression is not stated. `@section($slot)`, `@include($view)` and `href=\"{{ route('home') }}\"` put a `php_statement` where the literal would be, so the section, the view and the URL are unknown here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "The props an anonymous component declares with `@props(['title', 'color' => 'red'])` are not stated: the argument is a PHP array literal the Blade grammar leaves as one unparsed token."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Laravel's own directives -- `@csrf`, `@method`, `@can`, `@auth`, `@error`, `@livewire` and the `<livewire:...>` tag -- are not stated. They are a framework's vocabulary rather than the template language's and belong in a framework overlay."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Embedded JavaScript and CSS are handed to their own grammars only when the `<script>` or `<style>` carries no `type` or `lang`, and Blade interleaves `{{ }}` with them, so a script whose body is generated by a directive may not parse as a whole."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "@includeFirst(['a','b']) takes an array of candidate views and none of them is stated: the Pack would have to read inside an array literal to name one, and which is used is decided at render time."
  }
 ],
 "legacy_rules": []
