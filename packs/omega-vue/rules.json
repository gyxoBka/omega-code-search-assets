 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A single-file component is named by its file name, and a template is evaluated against a file's bytes with no path in scope, so the component this file defines is never declared here; a `<MyButton/>` is emitted under the tag's own spelling and is joined to a file or to an import of it by the reader."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "data"
   ],
   "reason": "A directive value or an interpolation is a JavaScript expression, and only its leading identifier path is read: `{{ user.name }}` is a mention of `user`, while `v-if=\"a && !b\"` and `@click=\"submit(id)\"` are stored under the whole expression and resolve to nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Props, emits, imports and component state live in the `<script>` block and are declared by the injected JavaScript or TypeScript, not here; of the names Vue's own template syntax introduces this Pack declares a `<slot name>`, a `ref` and a plain `v-for` alias, and not the aliases of a destructured or index-carrying `v-for` or of a `v-slot` scope."
  }
 ],
