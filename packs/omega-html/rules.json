 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A `class` attribute is not stated. It holds a whitespace-separated list, often a dozen utility names on one element, and an emission carries one name, so which stylesheet rule an element uses is not answered here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A `<meta>` is stated only when `content` follows `name`, `property` or `http-equiv` directly; `<meta charset>`, and a meta whose content is separated from its key by another attribute, are not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A `<title>` or heading is stated only when the element's whole content is one text node, so a heading containing markup (`<h2>The <code>init</code> flag</h2>`) names nothing. No other element's text is stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A URL is taken verbatim from the attribute. It is not resolved against `<base href>`, a template placeholder or a bundler's asset pipeline, so the name stated is the text written, not a file in the repository."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Embedded code is analysed only where the `type` or `lang` attribute names a language Omega has a grammar for; the contents of a `<script type=\"text/x-template\">` and of a `style` attribute are not read."
  }
 ],
 "legacy_rules": []
