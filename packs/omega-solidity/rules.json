 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A function's parameters are direct children of `function_definition` and the grammar gives no node spanning the list, so a declaration carries its visibility, mutability and return type but never its parameter list."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Inheritance and `using ... for` are recorded as links, not flattened: a function, state variable or operator a contract gets from a base contract or a library is not declared at the contract that uses it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A member call is named by its property alone -- `transfer`, not `token.transfer` -- because the receiver's type is not resolved, so calls into two different contracts that share a method name are one name here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "An import path is recorded exactly as written, remappings such as `@openzeppelin/...` included; it is not resolved to a file, and a bare `import \"X.sol\";` pulls in every symbol of that file without naming any of them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "scopes"
   ],
   "reason": "Inline assembly is covered only where Yul names something: a function it declares and a call to one. Storage slots, EVM builtins such as `sload` and `mstore`, and Yul locals are not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "types"
   ],
   "reason": "A type mention is the last identifier of a qualified name, so `Lib.Item` and `Item` are the same name here, and a mapping or array type is carried as the text the author wrote rather than decomposed into key and value types."
  }
 ],
 "legacy_rules": []
}
