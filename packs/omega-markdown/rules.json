 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Only reference-style links are visible. This parser is the block grammar, in which a paragraph's text is one opaque `inline` node, so inline links, autolinks and bare URLs written in prose are not stated and a document's outgoing links are under-reported."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A heading's name is its inline source as authored, so a heading written as `## The `Config` loader` keeps its backticks and link syntax; the inline grammar that would strip them is not part of this parser."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "scopes"
   ],
   "reason": "A code block is given a region only when its fence declares a language. An indented code block, and a fence with no info string, carry no language and are left unstated rather than guessed at."
  }
 ],
