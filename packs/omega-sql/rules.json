  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A column is named by the column alone. The qualifier of `u.email` is a correlation name local to one query, so the Pack cannot say which table a qualified column belongs to."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "An object is named by the last segment of its reference, so `analytics.events` and `public.events` are one name here and two tables of the same name in different schemas cannot be told apart."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references",
        "calls"
      ],
      "reason": "SQL has no import and no file path, so nothing in a statement says which file declares the table or function it names; every edge is resolved by name across the whole index."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "SQL assembled as a string at runtime, and objects an extension or a migration tool creates on its behalf, are not in the source and are neither declared nor referenced."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A derived table, `FROM (SELECT ...) AS t`, gets no correlation name: the alias belongs to the relation and the Pack only names a relation that is an object reference."
    }
  ],
