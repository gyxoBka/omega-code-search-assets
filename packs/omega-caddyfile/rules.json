 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Caddy's directive names are built into the server, not declared in any Caddyfile, so a directive is recorded as a configuration declaration at the point it is used and has nothing elsewhere to resolve against; two sites configuring `tls` declare `tls` twice."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only a directive's first operand is carried, so `reverse_proxy a:80 b:80` records one upstream and the second is not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A placeholder other than `{env.NAME}` -- `{http.request.uri}`, `{vars.x}`, `{re.name.1}`, `{path.0}` -- names a value Caddy computes per request that nothing in a repository declares, and is not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "`import` is recorded as a dependency on the text as written: a file glob is not expanded, and the directives a snippet contributes are not copied into the sites that import it, so a site's configuration is what its own block states."
  }
 ],
 "legacy_rules": []
