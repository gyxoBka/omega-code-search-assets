  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "An executable document is not checked against a schema. A selection is linked to a field declaration by name alone, so `id` in a query matches the `id` of every type that declares one, and a selection whose schema lives outside the repository resolves to nothing."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A type and its extensions are declared separately under the same name; the Pack does not merge them, so asking where a type is defined returns every `type X` and `extend type X` in the repository rather than one answer."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "An anonymous operation, `{ user { id } }`, names nothing and is not declared; its selections are still recorded as field references."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "A directive is recorded as declared and as applied; what it does is not modelled. Deprecation, federation keys and client-side directives carry meaning a framework overlay states, not this Pack."
    }
  ],
