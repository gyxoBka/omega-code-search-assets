 "decoders": [],
 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A constructor is spelled as a function whose declarator names the class, so it is recorded as an ordinary function; and where the grammar resolves the most vexing parse towards a declarator, `Widget w(x);` is recorded as a function too."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references",
    "calls"
   ],
   "reason": "Nothing is expanded. A macro is recorded where it is defined and where it is invoked, but declarations a macro generates do not exist for this Pack, and declarations inside every `#if` branch are recorded as if the build took them all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only namespace-scope variables, enumerators and class data members are declared. Locals, function parameters and template parameters are not: a callable carries its written parameter list as an attribute instead, so a parameter can be read off a signature but not searched for by name."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is recorded by the spelling of its callee, so every overload of a name shares one target, and a call through a function pointer, a `std::function`, a member pointer or a virtual base is not recorded as reaching any declaration."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A type reference is reduced to its leaf name: template arguments and namespace qualification are stripped, so `std::vector<Widget>` and a local `vector` are the same name here, and a type's own declaration site also counts as one reference to it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports",
    "modules"
   ],
   "reason": "An include or an imported module is recorded exactly as written. It is not resolved against the include path or the module map, no header text is attached to the file that includes it, and `export import` is recorded only as the import it contains."
  }
 ],
 "legacy_rules": []
