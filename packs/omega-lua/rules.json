 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "A required module is recorded as the string that was written. `require` searches `package.path` at run time, so the string is not resolved to a file, and `require(name)` with a computed argument is recorded as no import at all."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Lua declares nothing; a name exists because something assigned it. A field or global assigned in three places is declared three times, and a name reached only through a metatable `__index` chain, `setmetatable`, `rawset` or `_G[expr]` is declared nowhere."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "scopes"
   ],
   "reason": "Only file-scope names are declared. A `local` inside a function body is not, so a helper closure assigned to a local deep in a body has no declaration and the calls to it resolve to nothing."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is recorded under the last segment of the name written at the call site, so `M.f()` is a call to `f` and not to `M`'s `f`; a call through a local alias, a computed index `t[k]()` or a value another call returned is recorded under no name. Reads of `a.b` outside call position are deliberately not emitted: this grammar spells a callee and a field read as the same `dot_index_expression`, so emitting them would report most calls a second time as field reads."
  }
 ],
 "legacy_rules": []
