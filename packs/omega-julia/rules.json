 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "calls"
   ],
   "reason": "Julia dispatches on the types of all arguments, so one name is many methods. A call is recorded under the name it is spelled with and a definition under the name it gives; which method of that name a call reaches is a dispatch decision this Pack does not make."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references",
    "calls"
   ],
   "reason": "Julia writes a qualified call `M.f(x)` and a property read `obj.f` with the same node. A call is recorded at the last segment of its callee, `f`, and the part before the dot is not linked to anything; a `obj.f` that is not a call is not recorded at all, because the Pack cannot tell which of the two it is looking at."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A file is joined to a package by `include(\"other.jl\")` evaluated at load time, and the module a file's contents land in is decided by the file that includes it. Nothing here follows an include, so a file with no `module` of its own declares its names at file level."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "`<:` in a type head is the only subtype edge stated. Julia's other interfaces are duck-typed -- a type joins `AbstractArray`'s interface by having `size` and `getindex` methods -- and nothing in the syntax says so."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "imports"
   ],
   "reason": "Macros run before the code they produce exists, so a definition written by `@kwdef`, `@enum` or any other macro is not declared here; only the macro call is recorded."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "An import names a module, not a package version or a path: which `Project.toml` entry or which `LOAD_PATH` directory `using Foo` resolves to is a package-manager fact outside the file."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "scopes"
   ],
   "reason": "Names bound inside a body -- by a plain assignment, by a `for` binding, by a `catch` variable or by the parameters of an anonymous `x -> ...` function -- are not declared; what a file and a module declare is stated, what one body declares is not."
  }
 ],
 "legacy_rules": []
