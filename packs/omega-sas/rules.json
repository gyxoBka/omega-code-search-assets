 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "definitions"
   ],
   "reason": "A macro call is linked to a `%macro` of the same name in the indexed sources. SAS also resolves a call through the autocall path and through compiled macro catalogs, and a call whose name is built at run time (`%&driver`) has no name here, so a call with no declaration is not evidence that none exists."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A dataset name is taken as written. The default `WORK` library is not supplied, so `sales` and `work.sales` are two names, a libref is not followed to the datasets it holds, and a name assembled from macro variables (`&lib..&tbl`) is recorded with the ampersands in it and matches no dataset."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Macro variables are matched by name only. `%global`, `%local` and the symbol table they maintain are ordinary macro calls to this grammar, so the same name used in two macros is one name here and nothing says which scope a `&ref` reads."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "`%include` names a file or a fileref as written. The fileref is not resolved to a path, the included text is not parsed, and what it declares is not visible at the point of inclusion."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "scopes",
    "calls"
   ],
   "reason": "A PROC step is recorded as an invocation of the procedure and as the region it governs; what the procedure does to the datasets named in its options is SAS product behaviour and is not stated. `PROC SQL` has no procedure name node in this grammar and is reached only through the tables it creates and reads."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "A LIBNAME that names an external engine (ODBC, Oracle, Teradata) states its target in engine options rather than a path, and no path is recorded for it. Only the directory form `libname x \"/path\";` yields a library path."
  }
 ],
