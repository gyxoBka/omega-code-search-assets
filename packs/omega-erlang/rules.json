 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "The grammar parses everything inside a module attribute as ordinary expressions, so a type application in -spec, -type, -record or -callback is the same node as a local function call. Only a qualified m:f(...) is stated as a call; every bare application is stated as a plain reference, which is true of both."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Erlang identifies a function by name and arity, but a declaration carries only its name, so f/1 and f/2 are one name here. The arity is recorded on exports, imports and fun captures, where the source writes it."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "apply/3, a module or function held in a variable, and a call assembled by macro expansion name their target at run time; only calls written with a literal atom module and function are stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "An -include or -include_lib names a header path; the header is not read here, so the records, macros and types a module gets from one are declared in the header's own file and nothing states that this module now has them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Variables are single-assignment and function-local in Erlang, so no variable binding or use is indexed and no question about a variable can be answered across files."
  }
 ],
 "legacy_rules": []
