 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A batch variable has one flat namespace per name: `setlocal` and `endlocal` are leaf tokens here with no region between them, and `%VAR%` is expanded when the line is read while `!VAR!` is expanded when it runs. So every read of a name is linked to every `set` of that name in the file, and which assignment actually reaches a given line is not stated."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls"
   ],
   "reason": "A command is named by the word written on the line. A target that is itself a variable (`%TOOL% build`, `call %SCRIPT%`), or that is reached through `cmd /c`, `start`, `powershell -Command` or a pipe, is not resolved to the program finally run, and PATH lookup and the `.bat`/`.exe`/`.cmd` extension search are not performed."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "data"
   ],
   "reason": "`for` expands its set at run time, so the files a loop iterates and the values its variable takes are not known; likewise a redirection target containing a variable is stated as written, not as the path it resolves to."
  }
 ],
 "legacy_rules": []
