 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "CSS has no single definition site: every selector that mentions `.btn` declares it, in this file and in every other, and a custom property is declared under its own name with no record of the rule it sits in, so `--bg` in `:root` and `--bg` in `.dark` are two declarations of one name."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "A rule inside `@media`, `@supports`, `@scope` or `@layer` is stated exactly like one outside it: the condition under which a declaration applies, and the cascade order that decides which of two rules wins, are not facts this Pack emits."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "Tag names, pseudo-classes, attribute selectors and ordinary property names are not stated: they name the HTML and CSS vocabularies rather than anything this repository declares, so a question about `div`, `:hover` or `grid-template-areas` is not answered from here."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A keyframes name is read from `animation-name` and from the `animation` shorthand with CSS's own timing, direction and fill keywords excluded by name, so an animation called `linear` or `both` is missed, and one named by a `var()` is not resolved."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A `url()` or `@import` target is recorded as written: a relative path is not resolved against the stylesheet's own location, and a remote or `data:` target names no file in the repository."
  }
 ],
 "legacy_rules": []
