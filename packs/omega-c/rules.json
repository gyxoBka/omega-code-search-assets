 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references",
    "calls"
   ],
   "reason": "Nothing is expanded and every branch is taken. A macro is recorded where it is defined and where it is named in a condition, but a declaration that a macro body generates does not exist for this Pack, a call written as a macro invocation is recorded as a call to the macro, and declarations inside every #if, #ifdef and #else arm are recorded as if the build selected all of them."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only file-scope variables, struct and union members, enumerators, labels and macros are declared. A local variable and a function parameter are not: a callable carries its written parameter list as an attribute, so a parameter can be read off a signature but not searched for by name."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "C has no namespaces and no module system. Two translation units that each define a static helper of the same name are one name here; `static` is carried as a modifier on the declaration, not resolved into linkage, and a prototype in a header and its definition in a .c file are two declarations of the same name rather than one."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "references"
   ],
   "reason": "A call is recorded by the spelling of its callee. A call through a function pointer reaches the pointer variable, not the function assigned to it; a member call `s->op(x)` is recorded under the member name, since which function a struct field holds is decided at run time."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "An #include is recorded exactly as written, not resolved against the include path, and no text of the included header is attached to the file that includes it. An include whose path is a macro or a call expression is not recorded at all, because the path does not exist until the preprocessor has run."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "Compiler extensions carry no fact here: GNU inline asm, __attribute__ and __declspec argument lists, MSVC pointer modifiers and SEH clauses are read past, so a question like which functions are marked deprecated or which are exported is not answered. Only the C23 [[attribute]] spelling is recorded, by name."
  }
 ],
