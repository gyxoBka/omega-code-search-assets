  "coverage_guards": [
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A `res://` or `user://` string is stated as a dependency on the file it names; that file is never opened, so a scene that instances another scene does not gain the nodes, the properties or the script of the scene it instances."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "references"
      ],
      "reason": "A `uid://` identifier is an opaque alias that only Godot's project-wide UID table can turn into a path, so `uid=` attributes and `uid://` values are not stated as dependencies; the `path=` written beside them is."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions",
        "references"
      ],
      "reason": "A node's place in the scene tree is taken from the `parent`, `from` and `to` paths as they were written, reduced to their last segment, so two nodes with the same name under different parents are one name here and `.` (the scene root) is not named at all."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "A property is located by its key and its value is not stored, because a single Godot property can hold megabytes of packed array data; the parts of a value that name something - a resource path, a resource id, a Godot class - are stated separately on their own spans."
    },
    {
      "query": "queries.scm",
      "capabilities": [
        "definitions"
      ],
      "reason": "Godot is never run: a `.import` file's generated output, the properties a script exports into the inspector, and any node or resource created at runtime are not written in these files and are not stated."
    }
  ],
