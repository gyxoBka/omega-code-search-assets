 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "The Pack cannot see which file it is reading. The host runs it over every YAML file the parser accepts, so a file is taken to be a Compose file when, and only when, its top level is a mapping with a services, volumes, networks, secrets or configs key. A Compose file written as a flow mapping, or one whose sections arrive through a merge key, is not recognised at all; another YAML file that happens to use one of those five words at its top level is read as Compose."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "Only the five top-level sections declare names here. A service's own keys -- ports, environment, command, healthcheck, deploy, labels, restart -- are ordinary YAML keys carrying ordinary YAML values and are stated, with their values, by omega-yaml over the same bytes; stating them again would declare every Compose key twice."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A reference is stated under the name as it is written, with a mount's container path or a link alias removed by cutting at the first colon. Interpolation is not evaluated, so a service named ${APP}_db is stated with the dollar sign in it; extends.file and include are not followed, so a name declared in another Compose file is a reference to nothing; and profiles do not gate anything, so a dependency that is only active under a profile is stated like any other."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "An anchor is not expanded and a merge key is not applied, so a service that inherits depends_on, networks or an image from a YAML anchor has none of them stated at its own span. The image reference is stated whole, so the repository, the tag and the digest are not separated and an image pinned by digest does not match the same image named by tag."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A reference from one service to another, or to a volume, network or secret, is stated as a data relation rather than a dependency: the host admits only Artifact, Namespace, Callable and Contract at either end of a dependency, and a compose declaration is none of those."
  }
 ],
 "legacy_rules": []
