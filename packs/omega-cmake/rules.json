 "injections": [],
 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "calls",
    "definitions"
   ],
   "reason": "A command name is only visible where it is written literally. `cmake_language(CALL ${fn})` and a command whose name is assembled from a variable are calls this Pack cannot see, and a function defined inside an `if()` branch is declared here whether or not that branch is taken."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions",
    "references"
   ],
   "reason": "No value is evaluated. `set(${prefix}_SOURCES ...)` declares a name that exists only at configure time, and `${FOO}` is recorded as a reference to the literal name FOO, so neither resolves when the name is assembled from another variable."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A link dependency is recorded only where the library is written as a literal name: a generator expression `$<...>` or a variable holding a list is skipped. Of `install(TARGETS a b DESTINATION bin)` only the first target is recorded, because what follows a keyword there is a path and not a target."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "`include()` and `add_subdirectory()` are recorded by the text of their first argument, not resolved: a module found on CMAKE_MODULE_PATH and a path built from a variable are named, and the file they reach is not linked."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "tests"
   ],
   "reason": "Only `add_test` registers a test here. Tests created by a framework's discovery command -- gtest_discover_tests, catch_discover_tests, doctest_discover_tests -- are enumerated when cmake runs and belong to a framework overlay, so the list of tests in a project is partial."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "scopes"
   ],
   "reason": "`function()` is the only region emitted, because it is the only construct here that opens a variable scope: a macro runs in its caller's scope, and `if`, `foreach`, `while` and `block` bodies are not emitted."
  }
 ],
 "legacy_rules": []
