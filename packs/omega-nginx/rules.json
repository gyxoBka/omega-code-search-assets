 "coverage_guards": [
  {
   "query": "queries.scm",
   "capabilities": [
    "imports"
   ],
   "reason": "An `include` names a path and the Pack does not read it: directives a file inherits from an included file are not part of that file, and `include conf.d/*.conf` is one mention of a glob rather than one per file it expands to."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "references"
   ],
   "reason": "A `$variable` is linked to the `set`, `map`, `geo` or `split_clients` that gives it its name. Nginx's own built-in variables (`$host`, `$uri`, `$remote_addr`) and the regex captures `$1`..`$9` are declared nowhere and resolve to nothing. A pass target is taken from the host part of the URI, so `proxy_pass http://127.0.0.1:8000` and `unix:` sockets name an address, not an upstream."
  },
  {
   "query": "queries.scm",
   "capabilities": [
    "definitions"
   ],
   "reason": "A `server` block carries no name of its own: nginx identifies a virtual server by its `listen` and `server_name` directives, which are declared separately, so the block itself is only a region. A directive's parameters are stored as its value and are not interpreted -- a size, a timeout or a header value is text here, not a typed fact."
  }
 ],
 "legacy_rules": []
